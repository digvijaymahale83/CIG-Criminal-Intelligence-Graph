# =================================================================
# Criminal Intelligence & Network Investigation Platform
# Environment Configuration Template
# =================================================================

# -----------------------------------------------------------------
# 1. Frontend Configuration
# -----------------------------------------------------------------
# Base URL for REST API calls from React frontend
VITE_API_BASE_URL=http://localhost:5000

# -----------------------------------------------------------------
# 2. ASP.NET Core 8 Web API Configuration
# -----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000

# PostgreSQL Connection String
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=criminal_network_db;Username=postgres;Password=YOUR_POSTGRES_PASSWORD;Include Error Detail=true;

# JWT Authentication
Jwt__SecretKey=YOUR_SECURE_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS
Jwt__Issuer=CriminalNetworkAnalysis
Jwt__Audience=CriminalNetworkAnalysisClient
Jwt__ExpiryMinutes=480

# Neo4j Graph Database
Neo4j__Uri=bolt://localhost:7687
Neo4j__User=neo4j
Neo4j__Password=YOUR_NEO4J_PASSWORD

# Distributed Cache & Messaging
Redis__Configuration=localhost:6379,abortConnect=false,connectTimeout=3000
RabbitMQ__Host=localhost
RabbitMQ__Port=5672
RabbitMQ__Username=YOUR_RABBITMQ_USERNAME
RabbitMQ__Password=YOUR_RABBITMQ_PASSWORD

# Python FastAPI AI Analytics Service
AiService__BaseUrl=http://localhost:8000

# Evidence Storage
Storage__LocalPath=uploads/evidence
Storage__Endpoint=http://localhost:9000
Storage__AccessKey=YOUR_STORAGE_ACCESS_KEY
Storage__SecretKey=YOUR_STORAGE_SECRET_KEY

# -----------------------------------------------------------------
# 3. Python FastAPI AI Service Configuration
# -----------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# -----------------------------------------------------------------
# 4. Optional External Model Services (Phase 13+)
# -----------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
